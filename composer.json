    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Customers",
        "Admin tools",
        "Email",
        "block customers",
        "hold orders of blocked customers",
        "fraud customer blacklist"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-customer-block",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-backend-widget": "~2.7.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CustomerBlock\\": "src"
        }
    }
}
